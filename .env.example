# Optional locally; required to enable WalletConnect mobile wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Empty values use public RPC fallbacks. Use authenticated URLs in production.
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_ARBITRUM_RPC_URL=
NEXT_PUBLIC_POLYGON_RPC_URL=

# Server-only. Recommended for stable CoinGecko Demo API access in production.
COINGECKO_API_KEY=
